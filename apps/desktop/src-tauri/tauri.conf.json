{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSG Solo",
  "version": "0.1.0",
  "identifier": "com.zeruhur.osgsolo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "OSG Solo", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Play Open Strategy Games solo",
    "copyright": "Roberto Bisceglie"
  }
}
